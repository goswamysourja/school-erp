generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  PENDING
  PENDING_ADMIN
  ACTIVE
  INACTIVE
  SUSPENDED
  REJECTED
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  status      TenantStatus @default(PENDING)
  adminUserId String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  classes      Class[]
  sections     Section[]
  students     Student[]
  subjects     Subject[]
  teachers     Teacher[]
  certificates Certificate[]

  teachingAssignments     TeachingAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  users                   User[]                   @relation("TenantUsers")
  adminUser               User?                    @relation("TenantAdministrator", fields: [adminUserId], references: [id], onDelete: SetNull)

  academicYears   AcademicYear[]
  academicPeriods AcademicPeriod[]
  marks           Mark[]

  libraryStaffAssignments LibraryStaffAssignment[]
  libraryCategories       LibraryCategory[]
  libraryRacks            LibraryRack[]
  libraryBooks            LibraryBook[]
  libraryBookCopies       LibraryBookCopy[]
  libraryLoans            LibraryLoan[]
  librarySettings         LibrarySettings?

  @@map("tenants")
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  role      Role
  tenantId  String?
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt

  otps               Otp[]
  teacher            Teacher?
  tenant             Tenant?  @relation("TenantUsers", fields: [tenantId], references: [id])
  administeredTenant Tenant?  @relation("TenantAdministrator")

  libraryLoansIssued   LibraryLoan[] @relation("LibraryLoanIssuedBy")
  libraryLoansReturned LibraryLoan[] @relation("LibraryLoanReturnedBy")

  @@map("users")
}

model Otp {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otps")
}

model Class {
  id             String   @id @default(cuid())
  name           String
  academicYear   String
  isActive       Boolean  @default(true)
  tenantId       String
  academicYearId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  sections           Section[]
  academicYearRecord AcademicYear? @relation("ClassAcademicYear", fields: [academicYearId], references: [id])

  @@unique([tenantId, name, academicYear])
  @@index([tenantId])
  @@map("classes")
}

model Section {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  tenantId  String
  classId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  class    Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  students Student[]

  teachingAssignments     TeachingAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]

  @@unique([classId, name])
  @@index([tenantId])
  @@index([classId])
  @@map("sections")
}

model Student {
  id              String    @id @default(cuid())
  admissionNumber String
  firstName       String
  lastName        String
  gender          String
  dateOfBirth     DateTime?
  guardianName    String?
  phone           String?
  address         String?
  isActive        Boolean   @default(true)
  tenantId        String
  sectionId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  section      Section?      @relation(fields: [sectionId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  marks        Mark[]
  certificates Certificate[]
  libraryLoans LibraryLoan[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId])
  @@index([sectionId])
  @@map("students")
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teachingAssignments TeachingAssignment[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("subjects")
}

model Teacher {
  id                   String    @id @default(cuid())
  employeeId           String
  firstName            String
  lastName             String
  gender               Gender
  dateOfBirth          DateTime?
  address              String?
  highestQualification String?
  joiningDate          DateTime?
  isActive             Boolean   @default(true)
  tenantId             String
  userId               String    @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  teachingAssignments     TeachingAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  libraryStaffAssignments LibraryStaffAssignment[]

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@map("teachers")
}

model TeachingAssignment {
  id        String   @id @default(cuid())
  tenantId  String
  teacherId String
  sectionId String
  subjectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marks   Mark[]

  @@unique([sectionId, subjectId])
  @@index([tenantId])
  @@index([teacherId])
  @@index([sectionId])
  @@index([subjectId])
  @@map("teaching_assignments")
}

model ClassTeacherAssignment {
  id        String   @id @default(cuid())
  tenantId  String
  teacherId String
  sectionId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId])
  @@index([tenantId])
  @@index([teacherId])
  @@index([sectionId])
  @@map("class_teacher_assignments")
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  classes Class[]          @relation("ClassAcademicYear")
  periods AcademicPeriod[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("academic_years")
}

model AcademicPeriod {
  id              String             @id @default(cuid())
  name            String
  type            AcademicPeriodType
  startDate       DateTime
  endDate         DateTime
  marksUploadOpen Boolean            @default(false)
  marksLockedAt   DateTime?
  academicYearId  String
  tenantId        String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  marks        Mark[]

  @@unique([academicYearId, name])
  @@index([tenantId])
  @@index([academicYearId])
  @@map("academic_periods")
}

model Mark {
  id                   String   @id @default(cuid())
  tenantId             String
  studentId            String
  teachingAssignmentId String
  academicPeriodId     String
  marks                Decimal
  maxMarks             Decimal
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  student            Student            @relation(fields: [studentId], references: [id])
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id])
  academicPeriod     AcademicPeriod     @relation(fields: [academicPeriodId], references: [id])

  @@unique([studentId, teachingAssignmentId, academicPeriodId])
  @@index([tenantId])
  @@index([studentId])
  @@index([teachingAssignmentId])
  @@index([academicPeriodId])
  @@map("marks")
}

model Certificate {
  id                String             @id @default(cuid())
  certificateNumber String
  purpose           CertificatePurpose
  certificateType   String
  issueDate         DateTime

  studentId String
  tenantId  String

  eventName   String?
  eventDate   DateTime?
  position    String?
  achievement String?
  details     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, certificateNumber])
  @@index([tenantId])
  @@index([studentId])
  @@index([issueDate])
  @@index([purpose])
  @@map("certificates")
}

// LIBRARY MANAGEMENT

model LibraryStaffAssignment {
  id        String   @id @default(cuid())
  tenantId  String
  teacherId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([tenantId, teacherId])
  @@index([tenantId, isActive])
  @@index([teacherId])
  @@map("library_staff_assignments")
}

model LibraryCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  books  LibraryBook[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("library_categories")
}

model LibraryRack {
  id          String   @id @default(cuid())
  rackNumber  String
  description String?
  location    String?
  isActive    Boolean  @default(true)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  copies LibraryBookCopy[]

  @@unique([tenantId, rackNumber])
  @@index([tenantId, isActive])
  @@map("library_racks")
}

model LibraryBook {
  id              String   @id @default(cuid())
  title           String
  author          String?
  publisher       String?
  isbn            String?
  edition         String?
  publicationYear Int?
  language        String?
  description     String?
  isActive        Boolean  @default(true)
  categoryId      String
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category LibraryCategory   @relation(fields: [categoryId], references: [id])
  copies   LibraryBookCopy[]

  @@unique([tenantId, isbn])
  @@index([tenantId, title])
  @@index([tenantId, author])
  @@index([categoryId])
  @@map("library_books")
}

model LibraryBookCopy {
  id              String            @id @default(cuid())
  accessionNumber String
  barcode         String?
  status          LibraryCopyStatus @default(AVAILABLE)
  purchaseDate    DateTime?
  purchasePrice   Decimal?          @db.Decimal(10, 2)
  notes           String?
  bookId          String
  rackId          String?
  tenantId        String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  book   LibraryBook   @relation(fields: [bookId], references: [id])
  rack   LibraryRack?  @relation(fields: [rackId], references: [id])
  loans  LibraryLoan[]

  @@unique([tenantId, accessionNumber])
  @@unique([tenantId, barcode])
  @@index([tenantId, status])
  @@index([bookId])
  @@index([rackId])
  @@map("library_book_copies")
}

model LibraryLoan {
  id                    String            @id @default(cuid())
  tenantId              String
  bookCopyId            String
  studentId             String
  issuedByUserId        String
  returnedByUserId      String?
  issuedAt              DateTime          @default(now())
  dueAt                 DateTime
  returnedAt            DateTime?
  renewalCount          Int               @default(0)
  status                LibraryLoanStatus @default(ACTIVE)
  fineAmount            Decimal           @default(0.00) @db.Decimal(10, 2)
  finePaidAmount        Decimal           @default(0.00) @db.Decimal(10, 2)
  replacementCharge     Decimal           @default(0.00) @db.Decimal(10, 2)
  replacementPaidAmount Decimal           @default(0.00) @db.Decimal(10, 2)
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookCopy       LibraryBookCopy @relation(fields: [bookCopyId], references: [id])
  student        Student         @relation(fields: [studentId], references: [id])
  issuedByUser   User            @relation("LibraryLoanIssuedBy", fields: [issuedByUserId], references: [id])
  returnedByUser User?           @relation("LibraryLoanReturnedBy", fields: [returnedByUserId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, dueAt])
  @@index([studentId, status])
  @@index([bookCopyId])
  @@map("library_loans")
}

model LibrarySettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  maxBooksPerStudent Int      @default(3)
  loanPeriodDays     Int      @default(14)
  renewalLimit       Int      @default(1)
  gracePeriodDays    Int      @default(0)
  finePerDay         Decimal  @default(1.00) @db.Decimal(10, 2)
  lostBookCharge     Decimal  @default(0.00) @db.Decimal(10, 2)
  damagedBookCharge  Decimal  @default(0.00) @db.Decimal(10, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("library_settings")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AcademicPeriodType {
  TERM
  EXAM
}

enum CertificatePurpose {
  TRANSFER
  COMPETITION_WINNER
  COMPETITION_PARTICIPANT
  ACHIEVEMENT
  PARTICIPATION
}

enum LibraryCopyStatus {
  AVAILABLE
  ISSUED
  LOST
  DAMAGED
  MAINTENANCE
  REMOVED
}

enum LibraryLoanStatus {
  ACTIVE
  RETURNED
  LOST
}
