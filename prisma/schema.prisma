// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CLASS_TEACHER
  TEACHER
}

model Tenant {
  id String @id @default(cuid())

  name String
  slug String @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  classes  Class[]
  students Student[]
  subjects Subject[]

  @@map("tenants")
}

model User {
  id String @id @default(cuid())

  name  String
  email String @unique

  passwordHash String?

  role Role

  isActive Boolean @default(true)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  otps Otp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  managedClasses Class[] @relation("ClassTeacher")

  @@map("users")
}

model Otp {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  code      String
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@map("otps")
}

model Class {
  id String @id @default(cuid())

  name         String
  section      String
  academicYear String

  isActive Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  classTeacherId String?
  classTeacher   User?   @relation("ClassTeacher", fields: [classTeacherId], references: [id])

  students Student[]
  subjects Subject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([tenantId, name, section, academicYear])
  @@map("classes")
}

model Student {
  id String @id @default(cuid())

  admissionNumber String

  firstName String
  lastName  String

  gender String

  dateOfBirth DateTime?

  guardianName String?

  phone String?

  address String?

  isActive Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, admissionNumber])
  @@index([tenantId])
  @@index([classId])
  @@map("students")
}

model Subject {
  id String @id @default(cuid())

  name String

  code String

  description String?

  isActive Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, classId, code])
  @@unique([tenantId, classId, name])
  @@index([tenantId])
  @@index([classId])
  @@map("subjects")
}
