generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  PENDING
  PENDING_ADMIN
  ACTIVE
  INACTIVE
  SUSPENDED
  REJECTED
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  status      TenantStatus @default(PENDING)
  adminUserId String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  classes  Class[]
  sections Section[]
  students Student[]
  subjects Subject[]
  teachers Teacher[]

  teachingAssignments     TeachingAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]
  users                   User[]                   @relation("TenantUsers")
  adminUser               User?                    @relation("TenantAdministrator", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  role         Role
  tenantId     String?
  createdAt    DateTime @default(now())
  isActive     Boolean  @default(true)
  updatedAt    DateTime @default(now()) @updatedAt

  otps               Otp[]
  teacher            Teacher?
  tenant             Tenant?  @relation("TenantUsers", fields: [tenantId], references: [id])
  administeredTenant Tenant?  @relation("TenantAdministrator")

  @@map("users")
}

model Otp {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otps")
}

model Class {
  id           String   @id @default(cuid())
  name         String
  academicYear String
  isActive     Boolean  @default(true)
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  sections Section[]

  @@unique([tenantId, name, academicYear])
  @@index([tenantId])
  @@map("classes")
}

model Section {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  tenantId  String
  classId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  class    Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  students Student[]

  teachingAssignments     TeachingAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]

  @@unique([classId, name])
  @@index([tenantId])
  @@index([classId])
  @@map("sections")
}

model Student {
  id              String    @id @default(cuid())
  admissionNumber String
  firstName       String
  lastName        String
  gender          String
  dateOfBirth     DateTime?
  guardianName    String?
  phone           String?
  address         String?
  isActive        Boolean   @default(true)
  tenantId        String
  sectionId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  section Section? @relation(fields: [sectionId], references: [id])
  tenant  Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, admissionNumber])
  @@index([tenantId])
  @@index([sectionId])
  @@map("students")
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teachingAssignments TeachingAssignment[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("subjects")
}

model Teacher {
  id                   String    @id @default(cuid())
  employeeId           String
  firstName            String
  lastName             String
  gender               Gender
  dateOfBirth          DateTime?
  phone                String?
  address              String?
  highestQualification String?
  joiningDate          DateTime?
  isActive             Boolean   @default(true)
  tenantId             String
  userId               String    @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  teachingAssignments     TeachingAssignment[]
  classTeacherAssignments ClassTeacherAssignment[]

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@map("teachers")
}

model TeachingAssignment {
  id        String   @id @default(cuid())
  tenantId  String
  teacherId String
  sectionId String
  subjectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([sectionId, subjectId])
  @@index([tenantId])
  @@index([teacherId])
  @@index([sectionId])
  @@index([subjectId])
  @@map("teaching_assignments")
}

model ClassTeacherAssignment {
  id        String   @id @default(cuid())
  tenantId  String
  teacherId String
  sectionId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId])
  @@index([tenantId])
  @@index([teacherId])
  @@index([sectionId])
  @@map("class_teacher_assignments")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}
